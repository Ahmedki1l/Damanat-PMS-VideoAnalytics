# =============================================================================
# Dockerfile.multiprocess - PROPOSAL
#
# Adapts the existing single-process Dockerfile to run the PER-PROCESS camera
# groups (run_all.sh --foreground) instead of one `python main.py --api`. This
# is the scaling lever: 5 processes = 5 concurrent inference workers pinned to
# disjoint cores (taskset), vs one serial worker sharing ~2 inferences/sec over
# all 26 cameras.
#
# To adopt:   mv Dockerfile.multiprocess Dockerfile
#
# Diffs vs the current Dockerfile:
#   * runtime stage installs `util-linux` (provides taskset) + `procps`.
#   * ENTRYPOINT keeps the geometry seed, then launches run_all.sh --foreground
#     (one PID-1 process that supervises the 5 groups) instead of main.py --api.
#   * Pass extra launcher flags at run time via RUN_ALL_ARGS (e.g. --reset-plates).
#
# RUN IT (must expose all 16 cores so taskset's 0-15 pins are valid):
#   docker run --cpuset-cpus=0-15 -p 8000:8000 \
#     -e RUN_ALL_ARGS="" <image>
#   # ANPR server must POST to http://<host>:8000/api/anpr/event
#
# !! ODBC DRIVER MISMATCH TO RESOLVE !!
#   This installs msodbcsql18, but config.yaml's DATABASE_URL says
#   "ODBC Driver 17 for SQL Server". The driver name in the connection string
#   MUST match the installed package or pyodbc fails at connect. Either:
#     (a) change config.yaml to "ODBC Driver 18 for SQL Server" (keep
#         TrustServerCertificate=yes - Driver 18 defaults to Encrypt=yes), or
#     (b) swap msodbcsql18 -> msodbcsql17 below.
# =============================================================================

# =========================
# Stage 1: Builder
# =========================
FROM python:3.11-slim AS builder

WORKDIR /app

# Build deps (unixodbc-dev for pyodbc, git for any VCS installs).
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    unixodbc-dev \
    git \
    && rm -rf /var/lib/apt/lists/*

RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

RUN pip install --upgrade pip setuptools wheel

# Install in dependency order (numpy<2 first, then the heavy native wheels) so
# layers cache well and pip does not resolve to a GPU torch build.
RUN pip install --no-cache-dir "numpy<2.0.0"
RUN pip install --no-cache-dir Cython scipy
RUN pip install --no-cache-dir opencv-python-headless
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .

# Stable torchreid (legacy ReID fallback only; production ReID is OpenVINO).
RUN pip install --no-cache-dir torchreid==0.2.5
RUN pip install --no-cache-dir "lap>=0.5.12" "openvino>=2024.0.0"
RUN pip install --no-cache-dir -r requirements.txt


# =========================
# Stage 2: Runtime
# =========================
FROM python:3.11-slim

WORKDIR /app

# Runtime deps:
#   curl/gnupg   - MS repo key + health checks
#   unixodbc     - pyodbc runtime
#   libgl1 etc.  - opencv-python-headless shared libs
#   util-linux   - taskset (REQUIRED by run_all.sh core-pinning)
#   procps       - ps/kill niceties for the foreground supervisor
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    unixodbc \
    libxcb1 \
    libgl1 \
    libglib2.0-0 \
    util-linux \
    procps \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://packages.microsoft.com/keys/microsoft.asc | gpg --dearmor -o /etc/apt/keyrings/microsoft.gpg \
    && echo "deb [arch=amd64 signed-by=/etc/apt/keyrings/microsoft.gpg] https://packages.microsoft.com/debian/12/prod bookworm main" \
    > /etc/apt/sources.list.d/mssql-release.list \
    && apt-get update \
    && ACCEPT_EULA=Y apt-get install -y msodbcsql18 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# Bring the prebuilt venv over; put it first on PATH so run_all.sh's fallback
# (`command -v python3`) resolves to it (the baked /app/.venv is excluded via
# .dockerignore and would not exist anyway).
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

COPY . .

# The API host group listens here; the external ANPR/ramp/Park_Entry server
# POSTs to :8000. Publish it and open the host firewall.
EXPOSE 8000

# On start: seed the drawn zoning geometry into EMPTY tables (first-run only,
# --if-empty never clobbers live occupancy), then hand off to the multi-process
# launcher as PID 1. run_all.sh --foreground supervises the 5 groups, mirrors
# their logs to stdout (docker logs), and forwards SIGTERM on `docker stop`.
# Extra launcher flags via RUN_ALL_ARGS, e.g. -e RUN_ALL_ARGS="--reset-plates".
#   Toggle seed with SEED_GEOMETRY_ON_START=false; GEOMETRY_FILE=/path/dump.json
ENTRYPOINT ["sh", "-c", "if [ \"${SEED_GEOMETRY_ON_START:-true}\" = true ] && [ -f \"${GEOMETRY_FILE:-geometry.json}\" ]; then echo '[entrypoint] seeding geometry into empty tables...'; python tools/sync_geometry.py seed --in \"${GEOMETRY_FILE:-geometry.json}\" --if-empty || echo '[entrypoint] geometry seed skipped (continuing)'; fi; exec bash run_all.sh --foreground ${RUN_ALL_ARGS:-}"]
