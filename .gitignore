# YOLO model weights (download via setup_model.py)
*.pt

# WS-B color classifier — training intermediates and generated synthetic
# dataset live under models/color_classifier_openvino/. The IR (model.xml /
# model.bin / labels.json / README.md) is what we ship; everything else is
# regenerated by tools/train_color_classifier.py and is too large to track.
models/color_classifier_openvino/synthetic_dataset/
models/color_classifier_openvino/best.pt
models/color_classifier_openvino/model.onnx
models/color_classifier_openvino/training_metrics.json

# WS-B labelling worklist (created by tools/prepare_color_dataset.py).
# Humans edit it locally; the manifest.csv it produces is what's tracked.
tests/data/color_classifier/worklist.csv
tests/data/color_classifier/manifest.csv

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.eggs/

# Virtual environment
venv/
.venv/
env/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
Thumbs.db
.DS_Store

