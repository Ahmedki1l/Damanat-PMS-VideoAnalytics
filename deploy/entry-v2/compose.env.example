# Docker Compose interpolation only. This file is not passed into the container.
# Required: immutable registry tag or digest. Blank makes Compose validation fail.
VA_IMAGE=
VA_RUNTIME_ENV_FILE=/var/lib/jenkins/configs/pms-video-analytics/va.env
VA_CONFIG_FILE=/var/lib/jenkins/configs/pms-video-analytics/config.yaml
VA_GALLERY_DIR=/var/lib/jenkins/data/pms-video-analytics/vehicle_images
VA_BIND_IP=127.0.0.1
VA_HOST_PORT=8000

# Existing external network on which PMS and SQL resolve as `pms-ai` and `pms-mssql`.
DAMANAT_DOCKER_NETWORK=

# Field-calibration diagnostic: writes each zone entry frame to
# $VA_GALLERY_DIR/entry_zone_captures/ so ramp captures can be inspected on the
# host. Defaults to ON (/app/vehicle_images) when this line is absent, because
# the crops are otherwise RAM-only and a discarded visit leaves no artefact.
# Set it EMPTY to disable once calibration is finished — it persists transit
# imagery of every vehicle entering the zone.
#   ENTRY_V2_LOCAL_CAPTURE_DEBUG_DIR=
ENTRY_V2_LOCAL_CAPTURE_DEBUG_DIR=/app/vehicle_images
