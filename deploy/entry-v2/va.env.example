# VA runtime environment. Copy outside Git, restrict permissions, and inject
# through Docker Compose `env_file`; mounting this file alone does not load it.

# Start with off. After the off-mode health gate, put the same non-empty service
# key in PMS and VA and change ENTRY_V2_MODE=shadow on both services together.
PMS_API_URL=http://pms-ai:8080
ENTRY_V2_MODE=off
ENTRY_V2_SERVICE_KEY=

# One actual VA container is mandatory: Entry V2 state is in RAM, so a second
# replica splits an ANPR read from its ramp observation and neither pod can ever
# match them. Check the DEPLOYMENT's replica count, not just this file.
#
# The three below describe the BUILD 4 single-process engine, which bypasses the
# supervisor. THEY ARE NOT THE ONLY SUPPORTED TOPOLOGY, and on the multi-process
# supervisor (VA_CMD empty) they must all stay EMPTY:
#
#   * VA_SINGLE_PROCESS is an ENGINE switch, not an attestation. main.py reads
#     it to force VA_INFER=async and call engine.run_single_process(). Setting
#     it under the supervisor hands every group its own async queue.
#   * VA_PROCESS_COUNT is overwritten in each worker by supervisor.py, which
#     sets it to the group count. Setting it here changes nothing.
#
# Under the supervisor, co-location is attested instead by VA_ENTRY_HOST and
# VA_GROUP_CAMERAS, which supervisor.py sets on the one --api group. Never set
# either by hand: a pod-level VA_ENTRY_HOST would attest for every worker,
# including those owning no gate camera.
VA_PROCESS_COUNT=1
VA_SINGLE_PROCESS=1
VA_CMD=python main.py --api
VA_INFER=async
VA_INFER_NIREQ=16
VA_OV_NUM_THREADS=16
VA_FEED_THREADS=6
PERF_TRACE=1
PERF_TRACE_EVERY=50

# These duplicate the YAML shadow values intentionally so an old deployment
# environment cannot silently force either policy back to legacy.
VA_MOTION_SCHEDULER_MODE=shadow
VA_SLOT_STATE_MODE=shadow

# Must match the durable Docker bind mount.
SNAPSHOT_PATH=/app/vehicle_images

# The safe default enables CAM-23's calibrated VA-local zone only. Append the
# measured raw Hikvision line and inward direction after inspecting real webhook
# payloads; never guess those two camera values before authoritative mode.
ENTRY_V2_PRIMARY_CAMERAS=CAM-23
ENTRY_V2_PRIMARY_LINES=Park_Entry
ENTRY_V2_PRIMARY_DIRECTIONS=ramp-entry
ENTRY_V2_FALLBACK_CAMERAS=CAM-03
ENTRY_V2_FALLBACK_LINES=1,B1_Entrence
ENTRY_V2_FALLBACK_DIRECTIONS=B-to-A,b-entry

# Bounded in-memory coordination capacities.
ENTRY_V2_MAX_PENDING_ATTEMPTS=256
ENTRY_V2_MAX_PENDING_CROSSINGS=256
ENTRY_V2_MAX_PENDING_CALLBACKS=128
ENTRY_V2_MAX_CONCURRENT_INGEST_REQUESTS=2
ENTRY_V2_RECEIPT_CAPACITY=4096
ENTRY_V2_JOURNEY_CAPACITY=4096

# Multipart/image envelope.
ENTRY_V2_MAX_IMAGES=4
ENTRY_V2_MAX_IMAGE_BYTES=4194304
ENTRY_V2_MAX_DECODED_IMAGE_PIXELS=12000000
ENTRY_V2_MAX_DECODED_IMAGE_DIMENSION=8192
ENTRY_V2_MAX_METADATA_BYTES=16384

# Live entry matching thresholds.
ENTRY_V2_REID_MIN_SCORE=0.75
ENTRY_V2_REID_ROW_MARGIN=0.08
ENTRY_V2_REID_COLUMN_MARGIN=0.08
ENTRY_V2_MERGE_MIN_SCORE=0.82
ENTRY_V2_MERGE_MARGIN=0.08
ENTRY_V2_EVENT_CONSISTENCY_MIN_SCORE=0.82
ENTRY_V2_PRODUCER_PAIR_MAX_SKEW_SECONDS=5.0
ENTRY_V2_PRODUCER_PAIR_MIN_REID_SCORE=0.95
ENTRY_V2_OCR_MIN_CONFIDENCE=0.75
ENTRY_V2_CORRECTION_MIN_EVIDENCE=2
ENTRY_V2_CORRECTION_MIN_CAMERAS=2

# Stricter authorization for anything that may later enter the durable gallery.
ENTRY_V2_GALLERY_ANPR_MIN_CONFIDENCE=0.90
ENTRY_V2_GALLERY_REID_MIN_SCORE=0.85
ENTRY_V2_GALLERY_REID_ROW_MARGIN=0.12
ENTRY_V2_GALLERY_REID_COLUMN_MARGIN=0.12
ENTRY_V2_GALLERY_OCR_MIN_CONFIDENCE=0.90

# PMS callback transport. These are failure bounds, not a vehicle-entry timeout.
ENTRY_V2_CALLBACK_TIMEOUT_SECONDS=5.0
ENTRY_V2_CALLBACK_MAX_ATTEMPTS=1
ENTRY_V2_CALLBACK_INITIAL_BACKOFF_SECONDS=0.2
ENTRY_V2_CALLBACK_MAX_BACKOFF_SECONDS=2.0
ENTRY_V2_CALLBACK_RETRY_INTERVAL_SECONDS=5.0

# CPU-only plate detector/OCR. Empty OCR directory selects the Paddle cache
# baked into /opt/paddlex during the image build; it does not disable OCR.
ENTRY_V2_LPD_MODEL_DIR=models/yolo11n_lpd_openvino_model
ENTRY_V2_LPD_CONFIDENCE=0.30
ENTRY_V2_LPD_IOU=0.45
ENTRY_V2_LPD_THREADS=2
ENTRY_V2_OCR_MODEL_DIR=

# =========================================================================
# Entry Pipeline v3
# =========================================================================

# Emit logger.info at all. Without this the root logger has no handler,
# records fall through to logging.lastResort (WARNING), and every
# logger.info() in src/ is discarded - including the [EntryV2][ReID] line
# the whole calibration depends on.
LOG_LEVEL=INFO
# Per-logger overrides, "logger=LEVEL,logger=LEVEL". These beat everything,
# including the per-frame caps below.
#
# Raising the root logger to INFO switches on 146 logger.info() calls at once,
# and a few of them sit in the FRAME LOOP rather than on an event -
# engine_tracking's "[quality] track=... clearance=..." fires per detection.
# On a fleet that is already CPU-starved that is paid on every frame of every
# camera, and it would bury the entry decisions this was turned on to see. So
# src.core.engine.* and the tracker are capped at WARNING by default.
#
# Raise one deliberately when you are actually debugging it:
#   LOG_LEVEL_OVERRIDES=src.core.engine.engine_tracking=INFO
LOG_LEVEL_OVERRIDES=

# ---- the decision log -----------------------------------------------------
# The pipeline raises NO alerts. Every outcome - confirmed, ambiguous,
# abstained, unreadable, expired, degraded - is a record in this file, so
# this directory is the entire operational surface. Empty disables it.
#
# Point it at the volume the vehicle images live on. Every record cites
# image paths there, and a log that outlives the images it references is not
# evidence. /app/vehicle_images is the gallery mount and must be PVC-backed;
# on an emptyDir the run dies with the pod.
ENTRY_V2_DECISION_LOG_DIR=/app/vehicle_images/entry_v2_shadow
# The writer rolls over daily but never prunes, and it shares a volume with
# vehicle imagery. Files are deleted by the DAY IN THEIR FILENAME, not mtime.
ENTRY_V2_DECISION_LOG_RETENTION_DAYS=30
ENTRY_V2_DECISION_LOG_QUEUE_MAX=2000

# ---- identity lifetimes ---------------------------------------------------
# How long an UNCONFIRMED entry identity stays eligible for correlation.
# A LIFETIME, never an identity rule: it bounds how long a candidate exists
# and never says two observations are the same vehicle. Refreshed when a
# second ANPR read of the same plate arrives ("creates OR activates").
#
# This is 90x the legacy path's 10s FIFO bind window, and safe only because
# nothing here binds a plate by arrival order. If FIFO ever returns to the
# binding path, bring this down with it.
ENTRY_IDENTITY_TTL_MINUTES=15
# Observations outlive identities on purpose, so a late HikCentral sweep can
# still rescue a dropped entry after the ANPR side is gone. Must be >= the
# identity TTL or configuration fails.
ENTRY_OBSERVATION_TTL_MINUTES=60

# ---- subtractive signals --------------------------------------------------
# Colour REMOVES a candidate that cannot be this car; the margin is then
# recomputed over the survivors. It never adds score, because colour is
# low-entropy - two white sedans agreeing on colour is not evidence they are
# one car. Fails open whenever either colour is missing.
ENTRY_V2_COLOUR_VETO_ENABLED=1

# A ramp camera is not a plate source and never names a car. But a reliable
# read that contradicts the consensus plate is evidence Re-ID matched the
# wrong identity, so it WITHHOLDS the entry.
#
# Turn this OFF if the shadow window shows ramp reads are too unreliable to
# withhold on. Off means such contradictions are logged and ignored.
ENTRY_V2_OBSERVATION_PLATE_VETO_ENABLED=1

# ---- the overlay guard ----------------------------------------------------
# Normalised (x1,y1,x2,y2) boxes in 0..1, semicolon-separated, naming where
# Hikvision composites its own plate/OSD panel into a frame. A plate box
# whose CENTRE lands inside one is skipped for the next-ranked candidate.
#
# LEAVE EMPTY until the panel's real geometry is measured against this
# facility's own frames. A guessed rectangle rejects real plates, which is
# worse than the echo it is meant to prevent. While empty the guard is inert
# and logs a warning whenever a HikCentral-sourced frame is analysed.
#
#   ENTRY_V2_OVERLAY_EXCLUDE_REGIONS=0,0,0.25,0.20
ENTRY_V2_OVERLAY_EXCLUDE_REGIONS=
