# VA runtime environment. Copy outside Git, restrict permissions, and inject
# through Docker Compose `env_file`; mounting this file alone does not load it.

# Start with off. After the off-mode health gate, put the same non-empty service
# key in PMS and VA and change ENTRY_V2_MODE=shadow on both services together.
PMS_API_URL=http://pms-ai:8080
ENTRY_V2_MODE=off
ENTRY_V2_SERVICE_KEY=

# One actual VA container and one process are mandatory for local-zone and
# authoritative Entry V2 state.
VA_PROCESS_COUNT=1
VA_SINGLE_PROCESS=1
VA_CMD=python main.py --api
VA_INFER=async
VA_INFER_NIREQ=16
VA_OV_NUM_THREADS=16
VA_FEED_THREADS=6
PERF_TRACE=1
PERF_TRACE_EVERY=50

# These duplicate the YAML shadow values intentionally so an old deployment
# environment cannot silently force either policy back to legacy.
VA_MOTION_SCHEDULER_MODE=shadow
VA_SLOT_STATE_MODE=shadow

# Must match the durable Docker bind mount.
SNAPSHOT_PATH=/app/vehicle_images

# The safe default enables CAM-23's calibrated VA-local zone only. Append the
# measured raw Hikvision line and inward direction after inspecting real webhook
# payloads; never guess those two camera values before authoritative mode.
ENTRY_V2_PRIMARY_CAMERAS=CAM-23
ENTRY_V2_PRIMARY_LINES=Park_Entry
ENTRY_V2_PRIMARY_DIRECTIONS=ramp-entry
ENTRY_V2_FALLBACK_CAMERAS=CAM-03
ENTRY_V2_FALLBACK_LINES=1,B1_Entrence
ENTRY_V2_FALLBACK_DIRECTIONS=B-to-A,b-entry

# Bounded in-memory coordination capacities.
ENTRY_V2_MAX_PENDING_ATTEMPTS=256
ENTRY_V2_MAX_PENDING_CROSSINGS=256
ENTRY_V2_MAX_PENDING_CALLBACKS=128
ENTRY_V2_MAX_CONCURRENT_INGEST_REQUESTS=2
ENTRY_V2_RECEIPT_CAPACITY=4096
ENTRY_V2_JOURNEY_CAPACITY=4096

# Multipart/image envelope.
ENTRY_V2_MAX_IMAGES=4
ENTRY_V2_MAX_IMAGE_BYTES=4194304
ENTRY_V2_MAX_DECODED_IMAGE_PIXELS=12000000
ENTRY_V2_MAX_DECODED_IMAGE_DIMENSION=8192
ENTRY_V2_MAX_METADATA_BYTES=16384

# Live entry matching thresholds.
ENTRY_V2_REID_MIN_SCORE=0.75
ENTRY_V2_REID_ROW_MARGIN=0.08
ENTRY_V2_REID_COLUMN_MARGIN=0.08
ENTRY_V2_MERGE_MIN_SCORE=0.82
ENTRY_V2_MERGE_MARGIN=0.08
ENTRY_V2_EVENT_CONSISTENCY_MIN_SCORE=0.82
ENTRY_V2_PRODUCER_PAIR_MAX_SKEW_SECONDS=5.0
ENTRY_V2_PRODUCER_PAIR_MIN_REID_SCORE=0.95
ENTRY_V2_OCR_MIN_CONFIDENCE=0.75
ENTRY_V2_CORRECTION_MIN_EVIDENCE=2
ENTRY_V2_CORRECTION_MIN_CAMERAS=2

# Stricter authorization for anything that may later enter the durable gallery.
ENTRY_V2_GALLERY_ANPR_MIN_CONFIDENCE=0.90
ENTRY_V2_GALLERY_REID_MIN_SCORE=0.85
ENTRY_V2_GALLERY_REID_ROW_MARGIN=0.12
ENTRY_V2_GALLERY_REID_COLUMN_MARGIN=0.12
ENTRY_V2_GALLERY_OCR_MIN_CONFIDENCE=0.90

# PMS callback transport. These are failure bounds, not a vehicle-entry timeout.
ENTRY_V2_CALLBACK_TIMEOUT_SECONDS=5.0
ENTRY_V2_CALLBACK_MAX_ATTEMPTS=1
ENTRY_V2_CALLBACK_INITIAL_BACKOFF_SECONDS=0.2
ENTRY_V2_CALLBACK_MAX_BACKOFF_SECONDS=2.0
ENTRY_V2_CALLBACK_RETRY_INTERVAL_SECONDS=5.0

# CPU-only plate detector/OCR. Empty OCR directory selects the Paddle cache
# baked into /opt/paddlex during the image build; it does not disable OCR.
ENTRY_V2_LPD_MODEL_DIR=models/yolo11n_lpd_openvino_model
ENTRY_V2_LPD_CONFIDENCE=0.30
ENTRY_V2_LPD_IOU=0.45
ENTRY_V2_LPD_THREADS=2
ENTRY_V2_OCR_MODEL_DIR=
